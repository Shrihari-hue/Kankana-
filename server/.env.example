# ─────────────────────────────────────────────────────────────
#  Kankana server settings. Copy this file to server/.env and fill it in.
#  Never share or commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Your live website address (used in emails and PDFs). No trailing slash.
SITE_URL=https://www.kankana.in
NODE_ENV=production
PORT=3000
# Set to 1 when running behind Render/Railway/Nginx so rate limits see real visitor IPs
TRUST_PROXY=1
# Where the database is stored — must be a persistent disk in production
DATA_DIR=./server/data

# First admin login (only used the very first time the server starts)
ADMIN_EMAIL=you@kankana.in
ADMIN_PASSWORD=choose-a-long-password

# Who gets a copy of new bookings and payments
ADMIN_NOTIFY_EMAIL=you@kankana.in

# ── Razorpay (Dashboard → Account & Settings → API Keys) ──
# Start with rzp_test_ keys, switch to rzp_live_ after KYC is approved.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard → Webhooks → add https://YOUR-SITE/api/razorpay/webhook
# events: payment.captured, order.paid — then paste the secret you chose here
RAZORPAY_WEBHOOK_SECRET=choose-a-webhook-secret

# ── Email: use EITHER SMTP or Resend ──
# SMTP (Zoho Mail, Google Workspace, Hostinger, GoDaddy…)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@kankana.in
SMTP_PASS=app-specific-password
MAIL_FROM=Kankana <hello@kankana.in>

# …or Resend (https://resend.com) — comment out the SMTP lines above if you use this
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Kankana <bookings@kankana.in>

# Local testing only: simulate payments without Razorpay (ignored in production)
# PAYMENTS_MODE=mock
